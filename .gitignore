.local-preview.*.log
.codex-preview.*.log
pb-hook-test.*.log
/.analysis-worker-token
/tools/ffmpeg/
/tools/ffmpeg-release-essentials.zip
/tools/pocketbase/
/.pnpm-store/
.codex-*.log
/tmp_content_factory_sources.txt
*.tsbuildinfo

# local runtime logs and browser profiles
/*.log
/.runtime/
/.worker-logs/

# generated analysis/import artifacts and local scratch data
/analysis_artifacts/
/analysis_*/
/temp/
/pb_data/logs.db
/public/material-analysis/
/public/material-covers/
/public/material-previews/
/public/material-library/

